# Local NagrikSetu configuration reference. SARVAM_API_KEY is loaded from .env;
# other optional settings can be set in the VS Code terminal environment.
# There is no separate HTTP backend or API base URL in this Streamlit project.

# Optional override. Relative paths resolve from the project root.
# Default: db/nyayaflow.db
NYAYAFLOW_DB_PATH=db/nyayaflow.db

# Local prototype defaults.
NAGRIKSETU_DEMO_MODE=1
# Explicitly opt in to append-only Gwalior city assignments for the three
# reserved synthetic demo staff accounts. Unset/0 in shared or production environments.
NYAYAFLOW_SEED_DEMO_STAFF=1
NAGRIKSETU_DEMO_SLA_DAYS=7

# Optional feature switches (on by default). Set 0/false to disable each feature.
NYAYAFLOW_FEATURE_VOICE=1
NYAYAFLOW_FEATURE_PHOTOS=1
NYAYAFLOW_FEATURE_HOTSPOTS=1
NYAYAFLOW_FEATURE_CITIZEN_REVIEW=1
NYAYAFLOW_FEATURE_LEARNING=1
# RBAC is always enforced and deliberately has no disable switch.

# Configure only when using these features; never commit real values.
# NAGRIKSETU_AUTH_SECRET=
# NYAYAFLOW_ATTACHMENT_KEY=
SARVAM_API_KEY=replace-with-fresh-sarvam-key
# NYAYAFLOW_TLS_CERT=
# NYAYAFLOW_TLS_KEY=
# NYAYAFLOW_GEO_ADMIN_EMAILS=
